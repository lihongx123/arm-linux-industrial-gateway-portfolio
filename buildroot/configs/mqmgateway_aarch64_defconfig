BR2_PACKAGE_RAPIDJSON=y
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_SPDLOG=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
BR2_PACKAGE_TIME=y
BR2_PACKAGE_YAML_CPP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="384M"
